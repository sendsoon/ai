{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sendsoon-api/v1/emails/send",
  "title": "SendSoon Private API — Send Email (ASSUMED)",
  "description": "Assumed contract for POST /v1/emails/send. Adjust field mapping in core/client.ts after API finalization. NOT a public guarantee.",
  "status": "assumed",
  "endpoint": {
    "method": "POST",
    "url": "https://api.sendsoonai.com/v1/emails/send",
    "authentication": {
      "type": "bearer",
      "header": "Authorization",
      "envVar": "SENDSOON_API_KEY"
    },
    "headers": {
      "Content-Type": "application/json",
      "Accept": "application/json"
    }
  },
  "requestBody": {
    "type": "object",
    "required": ["to", "subject", "body"],
    "properties": {
      "to": { "type": "string", "format": "email" },
      "subject": { "type": "string" },
      "body": { "type": "string" },
      "content_type": {
        "type": "string",
        "enum": ["text/plain", "text/html"],
        "default": "text/plain"
      },
      "from_alias": { "type": "string" }
    }
  },
  "responses": {
    "200": {
      "description": "Email accepted for delivery",
      "body": {
        "type": "object",
        "properties": {
          "message_id": { "type": "string" },
          "id": { "type": "string", "description": "Fallback if message_id absent" },
          "status": { "type": "string", "enum": ["queued", "sent"] }
        }
      }
    },
    "400": { "description": "Invalid parameters → map to INVALID_INPUT" },
    "401": { "description": "Unauthorized → AUTH_ERROR" },
    "403": { "description": "Forbidden → AUTH_ERROR" },
    "413": { "description": "Payload too large → PAYLOAD_TOO_LARGE" },
    "429": { "description": "Rate limited → RATE_LIMITED (retry)" },
    "5xx": { "description": "Server error → SERVER_ERROR (retry)" }
  }
}
