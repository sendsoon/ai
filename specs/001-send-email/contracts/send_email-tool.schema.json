{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sendsoon-connect/send_email-tool",
  "title": "send_email MCP Tool Contract",
  "description": "SendSoon Connect adapter — single email send tool for MCP clients",
  "toolName": "send_email",
  "version": "1.0.0",
  "input": {
    "type": "object",
    "required": ["to", "subject", "body"],
    "additionalProperties": false,
    "properties": {
      "to": {
        "type": "string",
        "format": "email",
        "description": "Recipient email address"
      },
      "subject": {
        "type": "string",
        "minLength": 1,
        "maxLength": 998,
        "description": "Email subject line"
      },
      "body": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512000,
        "description": "Email body (plain text or HTML)"
      },
      "content_type": {
        "type": "string",
        "enum": ["text/plain", "text/html"],
        "default": "text/plain",
        "description": "MIME content type for body"
      },
      "from_alias": {
        "type": "string",
        "maxLength": 128,
        "description": "Optional display name for sender"
      }
    }
  },
  "output": {
    "type": "object",
    "required": ["success"],
    "additionalProperties": false,
    "properties": {
      "success": {
        "type": "boolean"
      },
      "message_id": {
        "type": "string",
        "minLength": 1,
        "description": "Present when success is true"
      },
      "error": {
        "type": "object",
        "required": ["code", "message", "retryable"],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_INPUT",
              "INVALID_RECIPIENT",
              "AUTH_ERROR",
              "PAYLOAD_TOO_LARGE",
              "RATE_LIMITED",
              "SERVER_ERROR",
              "NETWORK_ERROR"
            ]
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "description": "Present when success is false"
      }
    },
    "oneOf": [
      {
        "properties": { "success": { "const": true } },
        "required": ["message_id"]
      },
      {
        "properties": { "success": { "const": false } },
        "required": ["error"]
      }
    ]
  }
}
