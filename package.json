{
  "name": "sendsoon-mcp",
  "version": "0.3.7",
  "private": true,
  "description": "Private monorepo root (not published). Public npm package is @sendsoon/mcp under npm/.",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "workspaces": [
    "npm"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "bundle": "pnpm --filter @sendsoon/mcp run bundle",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint npm/src",
    "check": "pnpm run lint && pnpm run typecheck",
    "version:sync": "node version.mjs sync",
    "version:check": "node version.mjs check"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.0.0"
  }
}
